# Copy to .env and fill in. Never commit .env.
# Generate a secret with:  openssl rand -hex 32

# --- Container user --------------------------------------------------------
# Must match the host user that owns the repo, so bind-mounted files stay
# writable from inside the container:  id -u  /  id -g
DOCKER_UID=1000
DOCKER_GID=1000

# --- Runtime ---------------------------------------------------------------
ENV=dev                        # dev | test | prod
LOG_LEVEL=INFO

# --- Postgres (consumed by the `db` service and by DATABASE_URL) -----------
POSTGRES_USER=pingboard
POSTGRES_PASSWORD=pingboard
POSTGRES_DB=pingboard
# Host-side port only. Containers always reach Postgres on db:5432.
# Defaults are off the standard ports so a locally installed
# Postgres/Redis doesn't collide with the compose stack.
POSTGRES_PORT=5433

# Inside docker compose the api service overrides this with host `db`.
# Set it explicitly when running the API outside of compose.
DATABASE_URL=postgresql+asyncpg://pingboard:pingboard@localhost:5433/pingboard

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Auth (Phase 1) --------------------------------------------------------
JWT_SECRET=change-me-to-at-least-32-random-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Refresh-token cookie --------------------------------------------------
REFRESH_COOKIE_NAME=pb_refresh
REFRESH_COOKIE_PATH=/auth
# lax | strict | none. Use `none` (with COOKIE_SECURE=true) only when the
# frontend and API are on genuinely different sites, e.g. *.vercel.app calling
# *.fly.dev. Different ports on one host are still same-site, so `lax` is right
# in development.
COOKIE_SAMESITE=lax
# Blank follows ENV: secure in prod, not in dev. Set true/false to force it.
COOKIE_SECURE=
COOKIE_DOMAIN=

# --- Invites ---------------------------------------------------------------
INVITE_EXPIRE_HOURS=72

# --- Auth rate limiting ----------------------------------------------------
# Fixed window per client IP on /auth/login and /auth/register.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_S=60

# --- GitHub OAuth (Phase 1, optional) --------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- SMTP (Phase 1 invites / Phase 4 alerts, optional) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pingboard.local
SMTP_TLS=true

# --- Web -------------------------------------------------------------------
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
